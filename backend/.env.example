# PRISM Backend Environment Variables
# Copy this file to .env and fill in your values.

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# SQLite database URL. Defaults to data/prism.db relative to backend/.
DATABASE_URL=sqlite:///data/prism.db

# ------------------------------------------------------------------
# Simulation
# ------------------------------------------------------------------
# Tick interval in milliseconds (default: 2000)
SIMULATION_SPEED_MS=2000

# ------------------------------------------------------------------
# Google Gemini AI Adapter
# ------------------------------------------------------------------
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
